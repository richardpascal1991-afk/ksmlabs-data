<%- include('../partials/header', { title: 'Tableau de bord' }) %>

<h1>Tableau de bord</h1>
<p class="subtitle">Bienvenue <%= adminUsername %>.</p>

<div class="stat-tiles">
  <div class="stat-tile">
    <span class="stat-tile-value" data-countup="<%= activePlayerCount %>">0</span>
    <span class="stat-tile-label">Joueurs actifs</span>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-value" data-countup="<%= players.length %>">0</span>
    <span class="stat-tile-label">Joueurs au total</span>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-value" data-countup="<%= reportCount %>">0</span>
    <span class="stat-tile-label">Rapports publiés</span>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-value" data-countup="<%= reportsThisMonth %>">0</span>
    <span class="stat-tile-label">Rapports ce mois-ci</span>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-value" data-countup="<%= videoCount %>">0</span>
    <span class="stat-tile-label">Vidéos déposées</span>
  </div>
</div>

<div class="actions" style="margin-bottom:28px;">
  <a class="btn" href="/admin/joueurs/nouveau">+ Ajouter un joueur</a>
  <a class="btn btn-secondary" href="/admin/joueurs">Voir tous les joueurs</a>
</div>

<h2>Derniers rapports publiés</h2>
<% if (recentReports.length === 0) { %>
  <div class="empty-state">
    <p>Aucun rapport pour le moment.</p>
    <a class="btn btn-small" href="/admin/joueurs">Publier le premier rapport</a>
  </div>
<% } else { %>
  <% recentReports.forEach(r => { %>
    <a class="card-link" href="/admin/rapports/<%= r.id %>">
      <p class="card-title"><%= r.titre %> — <%= r.prenom %> <%= r.nom %></p>
      <p class="card-meta">
        <% if (r.adversaire) { %>vs <%= r.adversaire %> · <% } %>
        <%= r.date_match || 'date non renseignée' %>
      </p>
    </a>
  <% }) %>
<% } %>

<script src="/js/stats-animate.js" defer></script>

<%- include('../partials/footer') %>
