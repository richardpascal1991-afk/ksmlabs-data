<%- include('../partials/header', { title: player.prenom + ' ' + player.nom }) %>

<h1><%= player.prenom %> <%= player.nom %> <% if (!player.actif) { %><span class="badge badge-inactive">inactif</span><% } %></h1>
<p class="subtitle">Identifiant de connexion : <strong><%= player.identifiant %></strong></p>

<div class="profile-card">
  <% if (player.photo_filename) { %>
    <img class="profile-photo" src="/media/joueur-photo/<%= player.id %>" alt="Photo de <%= player.prenom %>" />
  <% } else { %>
    <div class="profile-photo profile-photo-empty">Photo</div>
  <% } %>
  <div class="profile-info">
    <% if (player.club_nom) { %>
      <p class="profile-club">
        <% if (player.club_logo_filename) { %>
          <img class="club-logo-sm" src="/media/club-logo/<%= player.id %>" alt="Logo <%= player.club_nom %>" />
        <% } %>
        <strong><%= player.club_nom %></strong><% if (player.club_pays) { %> · <%= player.club_pays %><% } %>
      </p>
    <% } %>
    <p class="card-meta">
      <% if (player.taille_cm) { %><span class="badge">Taille : <span data-countup="<%= player.taille_cm %>" data-suffix=" cm">0 cm</span></span> <% } %>
      <span class="badge">Matchs : <span data-countup="<%= player.nb_matchs || 0 %>">0</span></span>
    </p>
  </div>
</div>

<div class="alert alert-info" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
  <span>Nouvel espace joueur en préparation (bêta) — aperçu isolé, pas encore utilisé par le joueur.</span>
  <a class="btn btn-small btn-secondary" href="/admin/joueurs/<%= player.id %>/apercu-espace-joueur" target="_blank" rel="noopener">Voir l'aperçu</a>
</div>

<div class="card">
  <h3 style="margin-top:0;">Informations</h3>
  <form method="post" action="/admin/joueurs/<%= player.id %>" enctype="multipart/form-data">
    <div class="row">
      <div class="form-group">
        <label for="prenom">Prénom</label>
        <input type="text" id="prenom" name="prenom" value="<%= player.prenom %>" required />
      </div>
      <div class="form-group">
        <label for="nom">Nom</label>
        <input type="text" id="nom" name="nom" value="<%= player.nom %>" required />
      </div>
    </div>
    <div class="form-group">
      <label for="poste">Poste</label>
      <input type="text" id="poste" name="poste" value="<%= player.poste || '' %>" />
    </div>
    <div class="checkbox-row form-group">
      <input type="checkbox" id="actif" name="actif" value="1" <%= player.actif ? 'checked' : '' %> />
      <label for="actif">Compte actif (décoche pour bloquer l'accès sans supprimer les données)</label>
    </div>

    <h3>Photo du joueur</h3>
    <% if (player.photo_filename) { %>
      <div class="checkbox-row form-group">
        <input type="checkbox" id="remove_photo" name="remove_photo" value="1" />
        <label for="remove_photo" style="margin:0;">Supprimer la photo actuelle</label>
      </div>
    <% } %>
    <div class="form-group">
      <label for="photo">Remplacer la photo (PNG, JPG ou WEBP) — un outil de recadrage s'ouvre après le choix du fichier</label>
      <input type="file" id="photo" name="photo" accept=".png,.jpg,.jpeg,.webp"
             data-cropper data-cropper-preview="#photo-preview" />
      <img id="photo-preview" alt="Aperçu de la photo recadrée" style="display:none;margin-top:10px;width:96px;height:96px;border-radius:50%;object-fit:cover;border:2px solid var(--accent);" />
    </div>

    <h3>Club</h3>
    <div class="row">
      <div class="form-group">
        <label for="club_nom">Nom du club</label>
        <input type="text" id="club_nom" name="club_nom" value="<%= player.club_nom || '' %>" placeholder="ex : FC Exemple" />
      </div>
      <div class="form-group">
        <label for="club_pays">Pays du club</label>
        <input type="text" id="club_pays" name="club_pays" value="<%= player.club_pays || '' %>" placeholder="ex : France" />
      </div>
    </div>
    <% if (player.club_logo_filename) { %>
      <div class="checkbox-row form-group">
        <input type="checkbox" id="remove_club_logo" name="remove_club_logo" value="1" />
        <label for="remove_club_logo" style="margin:0;">Supprimer le logo actuel</label>
      </div>
    <% } %>
    <div class="form-group">
      <label for="club_logo">Remplacer le logo du club (PNG, JPG ou WEBP)</label>
      <input type="file" id="club_logo" name="club_logo" accept=".png,.jpg,.jpeg,.webp" />
    </div>

    <h3>Données</h3>
    <div class="row">
      <div class="form-group">
        <label for="taille_cm">Taille (cm)</label>
        <input type="text" inputmode="numeric" id="taille_cm" name="taille_cm" value="<%= player.taille_cm || '' %>" placeholder="ex : 182" />
      </div>
      <div class="form-group">
        <label for="nb_matchs">Nombre de matchs (à actualiser à tout moment)</label>
        <input type="text" inputmode="numeric" id="nb_matchs" name="nb_matchs" value="<%= player.nb_matchs || 0 %>" />
      </div>
    </div>
    <div class="row">
      <div class="form-group">
        <label for="numero">Numéro de maillot (optionnel)</label>
        <input type="text" inputmode="numeric" id="numero" name="numero" value="<%= player.numero || '' %>" placeholder="ex : 4" />
      </div>
      <div class="form-group">
        <label for="date_naissance">Date de naissance (optionnel)</label>
        <input type="date" id="date_naissance" name="date_naissance" value="<%= player.date_naissance || '' %>" />
      </div>
    </div>
    <div class="row">
      <div class="form-group">
        <label for="nationalite">Nationalité (optionnel)</label>
        <input type="text" id="nationalite" name="nationalite" value="<%= player.nationalite || '' %>" placeholder="ex : France" />
      </div>
      <div class="form-group">
        <label for="pied_fort">Pied fort (optionnel)</label>
        <select id="pied_fort" name="pied_fort">
          <option value="" <%= !player.pied_fort ? 'selected' : '' %>>Non renseigné</option>
          <option value="Droit" <%= player.pied_fort === 'Droit' ? 'selected' : '' %>>Droit</option>
          <option value="Gauche" <%= player.pied_fort === 'Gauche' ? 'selected' : '' %>>Gauche</option>
          <option value="Ambidextre" <%= player.pied_fort === 'Ambidextre' ? 'selected' : '' %>>Ambidextre</option>
        </select>
      </div>
    </div>

    <h3>Progression (optionnel)</h3>
    <div class="form-group">
      <label for="points_forts">Points forts (un par ligne)</label>
      <textarea id="points_forts" name="points_forts" placeholder="ex : Duels aériens&#10;Relance courte"><%= player.points_forts || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="axes_amelioration">Axes d'amélioration (un par ligne)</label>
      <textarea id="axes_amelioration" name="axes_amelioration" placeholder="ex : Pied faible&#10;Vitesse de replacement"><%= player.axes_amelioration || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="plan_travail">Plan de travail (un par ligne)</label>
      <textarea id="plan_travail" name="plan_travail" placeholder="ex : 2 séances techniques pied faible / semaine"><%= player.plan_travail || '' %></textarea>
    </div>

    <button type="submit" class="btn btn-secondary">Enregistrer</button>
  </form>
</div>

<div class="actions" style="margin-bottom:24px;">
  <form method="post" action="/admin/joueurs/<%= player.id %>/reinitialiser-code" class="inline-form">
    <button type="submit" class="btn btn-secondary">Régénérer le code d'accès</button>
  </form>
  <form method="post" action="/admin/joueurs/<%= player.id %>/supprimer" class="inline-form"
        data-confirm="Supprimer définitivement ce joueur et tous ses rapports ?">
    <button type="submit" class="btn btn-danger">Supprimer le joueur</button>
  </form>
</div>

<h2>Rapports</h2>
<div class="actions" style="margin-bottom:16px;">
  <a class="btn" href="/admin/joueurs/<%= player.id %>/rapports/nouveau">+ Nouveau rapport</a>
</div>

<% if (reports.length === 0) { %>
  <div class="empty-state">
    <p>Aucun rapport publié pour ce joueur.</p>
    <a class="btn btn-small" href="/admin/joueurs/<%= player.id %>/rapports/nouveau">+ Publier le premier rapport</a>
  </div>
<% } else { %>
  <% reports.forEach(r => { %>
    <a class="card-link" href="/admin/rapports/<%= r.id %>">
      <p class="card-title"><%= r.titre %></p>
      <p class="card-meta">
        <% if (r.adversaire) { %>vs <%= r.adversaire %> · <% } %>
        <%= r.date_match || 'date non renseignée' %>
        <% if (r.resultat) { %> · <%= r.resultat %><% } %>
      </p>
    </a>
  <% }) %>
<% } %>

<h2 style="margin-top:32px;">Vidéos correctives <span class="card-meta">(bêta — onglet « Analyses »)</span></h2>
<div class="actions" style="margin-bottom:16px;">
  <a class="btn" href="/admin/joueurs/<%= player.id %>/videos-correctives/nouvelle">+ Nouvelle vidéo corrective</a>
</div>

<% if (typeof videosCorrectives === 'undefined' || videosCorrectives.length === 0) { %>
  <div class="empty-state">
    <p>Aucune vidéo corrective pour ce joueur.</p>
    <a class="btn btn-small" href="/admin/joueurs/<%= player.id %>/videos-correctives/nouvelle">+ Ajouter la première</a>
  </div>
<% } else { %>
  <% videosCorrectives.forEach(v => { %>
    <a class="card-link" href="/admin/videos-correctives/<%= v.id %>">
      <p class="card-title"><%= v.titre %></p>
      <p class="card-meta">
        <%= v.theme %><% if (v.duree) { %> · <%= v.duree %><% } %><% if (!v.filename && !v.url) { %> · pas encore de vidéo attachée<% } %>
      </p>
    </a>
  <% }) %>
<% } %>

<h2 style="margin-top:32px;">Objectifs <span class="card-meta">(bêta — onglet « Progression »)</span></h2>
<div class="actions" style="margin-bottom:16px;">
  <a class="btn" href="/admin/joueurs/<%= player.id %>/objectifs/nouveau">+ Nouvel objectif</a>
</div>

<% if (typeof objectifs === 'undefined' || objectifs.length === 0) { %>
  <div class="empty-state">
    <p>Aucun objectif défini pour ce joueur.</p>
    <a class="btn btn-small" href="/admin/joueurs/<%= player.id %>/objectifs/nouveau">+ Ajouter le premier</a>
  </div>
<% } else { %>
  <% objectifs.forEach(o => { %>
    <a class="card-link" href="/admin/objectifs/<%= o.id %>">
      <p class="card-title"><%= o.titre %><% if (o.atteint) { %> <span class="badge badge-active">atteint</span><% } %></p>
      <p class="card-meta">Progression : <%= o.progression_pct %>%</p>
    </a>
  <% }) %>
<% } %>

<script src="/js/photo-cropper.js" defer></script>
<script src="/js/stats-animate.js" defer></script>

<%- include('../partials/footer') %>
