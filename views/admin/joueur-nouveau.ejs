<%- include('../partials/header', { title: 'Ajouter un joueur' }) %>

<h1>Ajouter un joueur</h1>
<p class="subtitle">Un identifiant et un code d'accès à 6 chiffres seront générés automatiquement.</p>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form method="post" action="/admin/joueurs" enctype="multipart/form-data">
  <div class="row">
    <div class="form-group">
      <label for="prenom">Prénom</label>
      <input type="text" id="prenom" name="prenom" value="<%= values.prenom || '' %>" required autofocus />
    </div>
    <div class="form-group">
      <label for="nom">Nom</label>
      <input type="text" id="nom" name="nom" value="<%= values.nom || '' %>" required />
    </div>
  </div>
  <div class="form-group">
    <label for="poste">Poste (optionnel)</label>
    <input type="text" id="poste" name="poste" value="<%= values.poste || '' %>" placeholder="ex : Milieu offensif" />
  </div>

  <h3 style="margin-top:28px;">Photo du joueur</h3>
  <div class="form-group">
    <label for="photo">Photo (PNG, JPG ou WEBP) — un outil de recadrage s'ouvre après le choix du fichier</label>
    <input type="file" id="photo" name="photo" accept=".png,.jpg,.jpeg,.webp"
           data-cropper data-cropper-preview="#photo-preview" />
    <img id="photo-preview" alt="Aperçu de la photo recadrée" style="display:none;margin-top:10px;width:96px;height:96px;border-radius:50%;object-fit:cover;border:2px solid var(--accent);" />
  </div>

  <h3 style="margin-top:28px;">Club</h3>
  <div class="row">
    <div class="form-group">
      <label for="club_nom">Nom du club</label>
      <input type="text" id="club_nom" name="club_nom" value="<%= values.club_nom || '' %>" placeholder="ex : FC Exemple" />
    </div>
    <div class="form-group">
      <label for="club_pays">Pays du club</label>
      <input type="text" id="club_pays" name="club_pays" value="<%= values.club_pays || '' %>" placeholder="ex : France" />
    </div>
  </div>
  <div class="form-group">
    <label for="club_logo">Logo du club (PNG, JPG ou WEBP)</label>
    <input type="file" id="club_logo" name="club_logo" accept=".png,.jpg,.jpeg,.webp" />
  </div>

  <h3 style="margin-top:28px;">Données</h3>
  <div class="row">
    <div class="form-group">
      <label for="taille_cm">Taille (cm)</label>
      <input type="text" inputmode="numeric" id="taille_cm" name="taille_cm" value="<%= values.taille_cm || '' %>" placeholder="ex : 182" />
    </div>
    <div class="form-group">
      <label for="nb_matchs">Nombre de matchs</label>
      <input type="text" inputmode="numeric" id="nb_matchs" name="nb_matchs" value="<%= values.nb_matchs || '' %>" placeholder="ex : 12" />
    </div>
  </div>
  <div class="row">
    <div class="form-group">
      <label for="numero">Numéro de maillot (optionnel)</label>
      <input type="text" inputmode="numeric" id="numero" name="numero" value="<%= values.numero || '' %>" placeholder="ex : 4" />
    </div>
    <div class="form-group">
      <label for="date_naissance">Date de naissance (optionnel)</label>
      <input type="date" id="date_naissance" name="date_naissance" value="<%= values.date_naissance || '' %>" />
    </div>
  </div>
  <div class="row">
    <div class="form-group">
      <label for="nationalite">Nationalité (optionnel)</label>
      <input type="text" id="nationalite" name="nationalite" value="<%= values.nationalite || '' %>" placeholder="ex : France" />
    </div>
    <div class="form-group">
      <label for="pied_fort">Pied fort (optionnel)</label>
      <select id="pied_fort" name="pied_fort">
        <option value="" <%= !values.pied_fort ? 'selected' : '' %>>Non renseigné</option>
        <option value="Droit" <%= values.pied_fort === 'Droit' ? 'selected' : '' %>>Droit</option>
        <option value="Gauche" <%= values.pied_fort === 'Gauche' ? 'selected' : '' %>>Gauche</option>
        <option value="Ambidextre" <%= values.pied_fort === 'Ambidextre' ? 'selected' : '' %>>Ambidextre</option>
      </select>
    </div>
  </div>

  <button type="submit" class="btn">Créer le joueur</button>
</form>

<script src="/js/photo-cropper.js" defer></script>

<%- include('../partials/footer') %>
