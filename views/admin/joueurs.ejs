<%- include('../partials/header', { title: 'Joueurs' }) %>

<%
  const ro = typeof readOnly !== 'undefined' && readOnly;
  const base = typeof baseUrl !== 'undefined' ? baseUrl : '/admin/joueurs';
%>

<h1>Joueurs</h1>
<p class="subtitle"><%= players.length %> joueur(s)</p>

<% if (!ro) { %>
<div class="actions" style="margin-bottom:20px;">
  <a class="btn" href="/admin/joueurs/nouveau">+ Ajouter un joueur</a>
</div>
<% } %>

<% if (players.length === 0) { %>
  <div class="empty-state">
    <p>Aucun joueur enregistré pour l'instant.</p>
    <% if (!ro) { %><a class="btn btn-small" href="/admin/joueurs/nouveau">+ Ajouter le premier joueur</a><% } %>
  </div>
<% } else { %>
  <% players.forEach(p => { %>
    <a class="card-link player-list-link" href="<%= base %>/<%= p.id %>">
      <% if (p.photo_filename) { %>
        <img class="player-list-photo" src="/media/joueur-photo/<%= p.id %>" alt="" />
      <% } else { %>
        <div class="player-list-photo player-list-photo-empty"></div>
      <% } %>
      <div class="player-list-info">
        <p class="card-title"><%= p.prenom %> <%= p.nom %></p>
        <p class="card-meta"><%= p.poste || 'poste non renseigné' %></p>
        <p class="card-meta player-list-club">
          <% if (p.club_logo_filename) { %>
            <img class="club-logo-sm" src="/media/club-logo/<%= p.id %>" alt="" />
          <% } %>
          <span><%= p.club_nom || 'club non renseigné' %></span>
        </p>
        <p class="card-meta player-list-stats">
          <span><%= p.nb_matchs || 0 %> match<%= (p.nb_matchs || 0) > 1 ? 's' : '' %> analysé<%= (p.nb_matchs || 0) > 1 ? 's' : '' %></span>
          <span class="player-list-dot">·</span>
          <span><% if (p.dernier_rapport_fr) { %>Dernier rapport : <%= p.dernier_rapport_fr %><% } else { %>Aucun rapport publié<% } %></span>
        </p>
      </div>
      <span class="badge player-list-status <%= p.actif ? 'badge-active' : 'badge-inactive' %>">
        <%= p.actif ? 'Actif' : 'Inactif' %>
      </span>
    </a>
  <% }) %>
<% } %>

<%- include('../partials/footer') %>
