<%- include('../partials/header', { title: 'Joueurs' }) %>

<h1>Joueurs</h1>
<p class="subtitle"><%= players.length %> joueur(s)</p>

<div class="actions" style="margin-bottom:20px;">
  <a class="btn" href="/admin/joueurs/nouveau">+ Ajouter un joueur</a>
</div>

<% if (players.length === 0) { %>
  <p class="subtitle">Aucun joueur enregistré pour l'instant.</p>
<% } else { %>
  <% players.forEach(p => { %>
    <a class="card-link player-list-link" href="/admin/joueurs/<%= p.id %>">
      <% if (p.photo_filename) { %>
        <img class="player-list-photo" src="/media/joueur-photo/<%= p.id %>" alt="" />
      <% } else { %>
        <div class="player-list-photo player-list-photo-empty"></div>
      <% } %>
      <div>
        <p class="card-title">
          <%= p.prenom %> <%= p.nom %>
          <% if (!p.actif) { %><span class="badge badge-inactive">inactif</span><% } %>
        </p>
        <p class="card-meta">
          <%= p.poste || 'poste non renseigné' %> · identifiant : <%= p.identifiant %>
          <% if (p.club_nom) { %> · <%= p.club_nom %><% } %>
        </p>
      </div>
    </a>
  <% }) %>
<% } %>

<%- include('../partials/footer') %>
