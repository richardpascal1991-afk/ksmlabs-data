<%- include('../partials/header', { title: 'Mon compte' }) %>

<h1>Mon compte</h1>
<p class="subtitle">Modifier mon mot de passe administrateur</p>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

<form method="post" action="/admin/mon-compte">
  <div class="form-group">
    <label for="current_password">Mot de passe actuel</label>
    <input type="password" id="current_password" name="current_password" autocomplete="current-password" required />
  </div>
  <div class="form-group">
    <label for="new_password">Nouveau mot de passe</label>
    <input type="password" id="new_password" name="new_password" autocomplete="new-password" required minlength="8" />
  </div>
  <div class="form-group">
    <label for="confirm_password">Confirmer le nouveau mot de passe</label>
    <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" required minlength="8" />
  </div>
  <button type="submit" class="btn">Mettre à jour</button>
</form>

<h1 style="margin-top:40px;">Accès collaborateurs</h1>
<p class="subtitle">
  Un seul identifiant et un seul code, à communiquer à toute ton équipe. Ils pourront consulter
  toutes les fiches joueurs (informations, rapports, vidéos correctives, objectifs) sans pouvoir
  rien modifier.
</p>

<% if (collabIdentifiant) { %>
  <p class="card-meta">Identifiant actuel : <strong><%= collabIdentifiant %></strong></p>
<% } else { %>
  <p class="card-meta">Aucun accès collaborateur configuré pour l'instant.</p>
<% } %>

<% if (collabError) { %><div class="alert alert-error"><%= collabError %></div><% } %>
<% if (collabSuccess) { %><div class="alert alert-success"><%= collabSuccess %></div><% } %>

<form method="post" action="/admin/collaborateur-acces">
  <div class="form-group">
    <label for="collab_identifiant">Identifiant</label>
    <input type="text" id="collab_identifiant" name="collab_identifiant" autocomplete="off" required
           value="<%= collabIdentifiant || '' %>" placeholder="ex : staff" />
  </div>
  <div class="form-group">
    <label for="collab_code">Nouveau code d'accès</label>
    <input type="text" id="collab_code" name="collab_code" autocomplete="off" required minlength="4"
           placeholder="ex : ksm2026" />
  </div>
  <button type="submit" class="btn btn-secondary">
    <%= collabIdentifiant ? 'Mettre à jour l\'accès collaborateur' : 'Activer l\'accès collaborateur' %>
  </button>
</form>

<%- include('../partials/footer') %>
