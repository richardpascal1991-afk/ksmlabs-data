<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title + " — " + agencyName : agencyName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <img src="/logo_1.jpeg" alt="<%= agencyName %>" style="width:34px;height:34px;border-radius:8px;object-fit:cover;display:block;" />
        <span class="brand-name"><%= agencyName %></span>
      </a>
      <nav class="topnav">
        <% if (isAdmin) { %>
          <a href="/admin">Tableau de bord</a>
          <a href="/admin/joueurs">Joueurs</a>
          <a href="/admin/mon-compte">Mon compte</a>
          <form action="/logout" method="post" class="inline-form">
            <button type="submit" class="link-button">Déconnexion</button>
          </form>
        <% } else if (isPlayer) { %>
          <a href="/joueur">Mes rapports</a>
          <a href="/joueur/mon-compte">Mon compte</a>
          <form action="/logout" method="post" class="inline-form">
            <button type="submit" class="link-button">Déconnexion</button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="container">
